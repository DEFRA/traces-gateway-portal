@page "/cookies"

@* GOV.UK cookies page pattern: https://design-system.service.gov.uk/patterns/cookies-page/
   The service only sets an essential cookie, so there is no cookie banner or consent form.
   If you add analytics or any other non-essential cookie, add the cookie banner component
   and a form on this page that lets people accept or reject those cookies. *@

<PageTitle>Cookies – @AppInfo.ServiceName</PageTitle>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Cookies</h1>
        <p class="govuk-body">Cookies are small files saved on your phone, tablet or computer when you visit a website.</p>
        <p class="govuk-body">We use cookies to make @AppInfo.ServiceName work. We do not use cookies to collect analytics or to track you.</p>

        <h2 class="govuk-heading-l">Essential cookies</h2>
        <p class="govuk-body">Essential cookies keep your information secure while you use the service. We do not need to ask permission to use them.</p>

        <GovUkTable Caption="Essential cookies we use" CaptionSize="m">
            <Head>
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Name</th>
                    <th scope="col" class="govuk-table__header">Purpose</th>
                    <th scope="col" class="govuk-table__header">Expires</th>
                </tr>
            </Head>
            <Body>
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">.AspNetCore.Antiforgery.<span class="govuk-visually-hidden"> followed by </span>[random characters]</td>
                    <td class="govuk-table__cell">Helps protect the service from cross-site request forgery attacks</td>
                    <td class="govuk-table__cell">When you close your browser</td>
                </tr>
            </Body>
        </GovUkTable>
    </div>
</div>
