@page "/"

<PageTitle>@AppInfo.ServiceName</PageTitle>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">@AppInfo.ServiceName</h1>
        <p class="govuk-body-l">Check whether the services you depend on are working, and see what has happened recently.</p>

        <h2 class="govuk-heading-m">
            <a class="govuk-link" href="/service-health">Service health</a>
        </h2>
        <p class="govuk-body">See the current status and response time of each monitored service.</p>

        <h2 class="govuk-heading-m">
            <a class="govuk-link" href="/latest-activity">Latest activity</a>
        </h2>
        <p class="govuk-body">See recent changes and events across the monitored services.</p>
    </div>
</div>
