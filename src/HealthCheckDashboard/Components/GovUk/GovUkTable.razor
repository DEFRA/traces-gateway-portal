@* https://design-system.service.gov.uk/components/table/
   Use govuk-table__row / __header / __cell classes inside Head and Body. *@
<table class="govuk-table @Class" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Caption))
    {
        <caption class="govuk-table__caption @CaptionClass">@Caption</caption>
    }
    @if (Head is not null)
    {
        <thead class="govuk-table__head">@Head</thead>
    }
    <tbody class="govuk-table__body">@Body</tbody>
</table>

@code {
    [Parameter] public string? Caption { get; set; }

    /// <summary>One of "s", "m", "l", "xl", or null for the default caption size.</summary>
    [Parameter] public string? CaptionSize { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Head { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? CaptionClass => CaptionSize is null ? null : $"govuk-table__caption--{CaptionSize}";
}
