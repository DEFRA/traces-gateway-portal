@* https://design-system.service.gov.uk/components/tag/ *@
<strong class="govuk-tag @ColourClass @Class" @attributes="AdditionalAttributes">@ChildContent</strong>

@code {
    [Parameter] public TagColour Colour { get; set; } = TagColour.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? ColourClass => Colour == TagColour.Default ? null : $"govuk-tag--{Colour.ToString().ToLowerInvariant()}";
}
