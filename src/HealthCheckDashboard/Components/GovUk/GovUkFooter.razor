@* https://design-system.service.gov.uk/components/footer/
   Put <li class="govuk-footer__inline-list-item"> support links in SupportLinks. *@
<footer class="govuk-footer">
    <div class="govuk-width-container">
        <div class="govuk-footer__meta">
            <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
                @if (SupportLinks is not null)
                {
                    <h2 class="govuk-visually-hidden">Support links</h2>
                    <ul class="govuk-footer__inline-list">
                        @SupportLinks
                    </ul>
                }
                @ChildContent
            </div>
        </div>
    </div>
</footer>

@code {
    [Parameter] public RenderFragment? SupportLinks { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
