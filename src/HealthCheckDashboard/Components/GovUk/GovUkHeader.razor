@* https://design-system.service.gov.uk/components/header/
   Uses a text logotype. Only services on the gov.uk domain may use the GOV.UK crown and name. *@
<header class="govuk-header" data-module="govuk-header">
    <div class="govuk-header__container govuk-width-container">
        <div class="govuk-header__logo">
            <a href="@HomepageUrl" class="govuk-header__link govuk-header__link--homepage">
                <span class="govuk-header__logotype-text">@Title</span>
            </a>
        </div>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string HomepageUrl { get; set; } = "/";
}
