@* https://design-system.service.gov.uk/components/button/
   Renders a link styled as a button when Href is set, otherwise a <button>. *@
@if (Href is not null)
{
    <a href="@Href" role="button" draggable="false" class="govuk-button @VariantClass @Class" data-module="govuk-button" @attributes="AdditionalAttributes">@ChildContent</a>
}
else
{
    <button type="@Type" class="govuk-button @VariantClass @Class" data-module="govuk-button" disabled="@Disabled" aria-disabled="@(Disabled ? "true" : null)" @attributes="AdditionalAttributes">@ChildContent</button>
}

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "submit";
    [Parameter] public bool Secondary { get; set; }
    [Parameter] public bool Warning { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? VariantClass => Warning ? "govuk-button--warning" : Secondary ? "govuk-button--secondary" : null;
}
