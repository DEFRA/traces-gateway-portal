@inherits LayoutComponentBase

<GovUkSkipLink />

@* This service isn't on GOV.UK, so it doesn't use the GOV.UK header (crown and "GOV.UK" name).
   The blue (inverse) service navigation gives the service name and the links to each section. *@
<GovUkServiceNavigation ServiceName="@AppInfo.ServiceName" Inverse="true">
    <GovUkServiceNavigationItem Href="/service-health" Text="Service health" />
    <GovUkServiceNavigationItem Href="/latest-activity" Text="Latest activity" />
</GovUkServiceNavigation>

<div class="govuk-width-container">
    <GovUkPhaseBanner Phase="Alpha">This is a new service.</GovUkPhaseBanner>
    <main class="govuk-main-wrapper" id="main-content">
        @Body
    </main>
</div>

<GovUkFooter>
    <SupportLinks>
        <li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="/accessibility-statement">Accessibility statement</a></li>
        <li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="/cookies">Cookies</a></li>
        <li class="govuk-footer__inline-list-item"><a class="govuk-footer__link" href="/privacy">Privacy</a></li>
    </SupportLinks>
    <ChildContent>
    <span class="govuk-footer__licence-description">
        Built with the <a class="govuk-footer__link" href="https://design-system.service.gov.uk/">GOV.UK Design System</a>
    </span>
    </ChildContent>
</GovUkFooter>
