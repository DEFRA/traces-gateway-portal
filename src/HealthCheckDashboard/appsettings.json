{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthChecks": {
    "TimeoutSeconds": 5,
    "CacheSeconds": 20,
    "DegradedThresholdMilliseconds": 1000,
    "Services": []
  }
}
