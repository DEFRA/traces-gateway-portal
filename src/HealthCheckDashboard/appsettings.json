{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.HealthChecks": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthChecks": {
    "TimeoutSeconds": 5,
    "CacheSeconds": 20,
    "DegradedThresholdMilliseconds": 1000,
    "Services": [
      { "Name": "Trade Gateway", "Url": "https://trade-gateway.{environment}.cdp-int.defra.cloud/health/all" },
      { "Name": "Trade Gateway Publisher", "Url": "https://trade-gateway-publisher.{environment}.cdp-int.defra.cloud/health/all" }
    ]
  }
}
