{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({Application}/{MachineName}/{ThreadId}/{SourceContext}.{Method}) {Message}{NewLine}{Exception}"
        }
      }
    ]
  },
  "HealthChecks": {
    "CacheSeconds": 5,
    "Services": [
      {
        "Name": "Trade Gateway",
        "Url": "http://localhost:5183/dev/fake-services/trade-gateway/health/all"
      },
      {
        "Name": "Trade Gateway Publisher",
        "Url": "http://localhost:5183/dev/fake-services/trade-gateway-publisher/health/all"
      }
    ]
  }
}
